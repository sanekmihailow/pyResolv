# pyresolv configuration (pydantic-settings). Copy to .env and fill in.
#
# Nested per-integration settings use the `__` delimiter:
#   <SECTION>__<FIELD>=value
# The graylog/gunter sections are optional if you don't use the corresponding
# stage (collect -> graylog, resolve -> gunter): trim, merge and aggregate need
# no configuration at all.
# If a section is filled in PARTIALLY (e.g. GRAYLOG__URL set but not
# GRAYLOG__STREAM_ID), the run fails with a clear validation error at startup.

# --- default source for `--type collect` when --source is not given
DEFAULT_SOURCE=graylog

# --- default resolver for `--type resolve` when --resolver is not given
DEFAULT_RESOLVER=gunter

# --- count threshold for `--type aggregate`: groups with count below this value
# are dropped from the result (e.g. 20 -> rows with count 1..19 are removed).
# 1 = no filtering (keep all). Overridden by the --min-count flag.
MIN_UNIQ_COUNT=1

# =====================================================================
# graylog (source for `--type collect --source graylog`)
# =====================================================================

# Base OpenSearch/Graylog URL (required for the graylog source)
GRAYLOG__URL=http://localhost:9200

# Index name without the date suffix (the query goes to <INDEX>_*)
GRAYLOG__INDEX=device_net

# Graylog stream ID used to filter documents (required)
GRAYLOG__STREAM_ID=69a0061e05036e88c213d8be

# Page size for search_after pagination
GRAYLOG__SEARCH_SIZE=5000

# HTTP request timeout to OpenSearch, seconds
GRAYLOG__REQUEST_TIMEOUT=300

# List of SrcIPs for the "terms" filter — a JSON array of strings. Empty/unset -> filter not applied.
GRAYLOG__SRC_IP_LIST=["10.2.83.129","10.2.83.130"]

# List of source subnets in CIDR — a JSON array of strings (e.g. "10.2.83.0/24",
# "10.2.83.0/25"). Serves two purposes: (1) collect filter — which SrcIPs to pull
# from graylog; (2) `aggregate --out-dir` split — one file per subnet. Empty/unset
# -> collect filter not applied. The graylog SrcIP field is a string holding a
# plain IPv4 without a mask, so the filter is a server-side prefix (on the octet
# boundary) plus an exact client-side ipaddress check (which makes /25 precise).
GRAYLOG__SRC_IP_CIDR=["10.2.83.0/24"]

# =====================================================================
# gunter (resolver for `--type resolve --resolver gunter`)
# =====================================================================

# Base URL of the Gunter API (required for the gunter resolver)
GUNTER__BASE_URL=https://gunter-resolve.example.ru/api

# HTTP request timeout to Gunter, seconds
GUNTER__REQUEST_TIMEOUT=30

# Default number of resolving threads (when --workers is not given)
GUNTER__MAX_WORKERS=3

# =====================================================================
# resolve (native resolvers: default / rdap / whois / geo_maxmind)
# =====================================================================
# These need no external service. `default` runs the chain GEO -> RDAP -> WHOIS.

# Path to a local MaxMind GeoLite2-City .mmdb for the geo_maxmind resolver.
# Unset -> geo_maxmind yields nothing and country falls back to RDAP/WHOIS codes.
# (Needs the optional extra: pip install -e '.[geo]')
# RESOLVE__MMDB_PATH=/var/lib/GeoIP/GeoLite2-City.mmdb

# Socket timeouts (seconds) for the network resolvers.
RESOLVE__RDAP_TIMEOUT=10
RESOLVE__WHOIS_TIMEOUT=15

# Конфигурация pyresolv (pydantic-settings). Скопируйте в .env и заполните.
#
# Вложенные настройки на интеграцию используют разделитель `__`:
#   <SECTION>__<FIELD>=значение
# Секции graylog/gunter не обязательны, если вы не используете
# соответствующую стадию (collect -> graylog, resolve -> gunter): trim,
# merge и aggregate не требуют никакой конфигурации вовсе.
# Если секция заполнена ЧАСТИЧНО (например, задан GRAYLOG__URL, но не
# GRAYLOG__STREAM_ID), запуск упадёт с понятной ошибкой валидации на старте.

# --- источник по умолчанию для `--type collect`, если не передан --source
DEFAULT_SOURCE=graylog

# --- резолвер по умолчанию для `--type resolve`, если не передан --resolver
DEFAULT_RESOLVER=gunter

# --- порог count для `--type aggregate`: группы с count ниже этого значения
# выбрасываются из результата (например 20 -> строки с count 1..19 удаляются).
# 1 = без фильтрации (оставить всё). Переопределяется флагом --min-count.
MIN_UNIQ_COUNT=1

# =====================================================================
# graylog (источник для `--type collect --source graylog`)
# =====================================================================

# Базовый URL OpenSearch/Graylog (обязательно для источника graylog)
GRAYLOG__URL=http://localhost:9200

# Имя индекса без суффикса даты (запрос идёт в <INDEX>_*)
GRAYLOG__INDEX=device_net

# ID Graylog-стрима, по которому фильтруются документы (обязательно)
GRAYLOG__STREAM_ID=69a0...d8be

# Размер страницы для пагинации search_after
GRAYLOG__SEARCH_SIZE=5000

# Таймаут HTTP-запроса к OpenSearch, сек
GRAYLOG__REQUEST_TIMEOUT=300

# Список SrcIP для фильтра "terms" — JSON-массив строк. Пусто/не задано -> фильтр не применяется.
GRAYLOG__SRC_IP_LIST=["192.168.10.129","192.168.10.130"]

# Список regex для фильтра SrcIP (regexp query) — JSON-массив строк, шаблоны
# объединяются по OR (SrcIP подходит, если совпал хотя бы с одним). Пусто/не
# задано -> фильтр не применяется.
# ВНИМАНИЕ 1: раньше здесь была опечатка r"10\.8\.\139\.\d+" — лишний "\" перед
# "139" делал из "\1" непреднамеренную backreference-группу. Ниже — исправлено.
# ВНИМАНИЕ 2: внутри JSON обратный слэш экранируется, поэтому "\." пишется как "\\.".
GRAYLOG__SRC_IP_REGEX=["192\\.168\\.10\\.\\d+"]

# =====================================================================
# gunter (резолвер для `--type resolve --resolver gunter`)
# =====================================================================

# Базовый URL API Gunter (обязательно для резолвера gunter)
GUNTER__BASE_URL=https://gunter-resolve.example.ru/api

# Таймаут HTTP-запроса к Gunter, сек
GUNTER__REQUEST_TIMEOUT=30

# Число потоков резолвинга по умолчанию (если не передан --workers)
GUNTER__MAX_WORKERS=3
